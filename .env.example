# Copy this file to .env and adjust. Generate secrets with:
#   node -e "console.log(crypto.randomUUID())"          # XRAY_UUID
#   node -e "console.log(crypto.randomBytes(16).toString('base64url'))"  # SS_PASSWORD
XRAY_UUID=eed58360-b925-49eb-bc32-775b1ec2ad8f
XRAY_PORT=8080
WS_PATH=/tunnel

SS_PASSWORD=change-me-aes-key-source
SS_METHOD=aes-256-gcm
SS_PORT=8082
SS_PATH=/ss

ECHO_PORT=8081
